{
  "name": "@inkyi/dsh-mcp-management",
  "version": "1.0.1",
  "description": "Workspace-scoped MCP servers for DeepSeek Harness: each project directory gets its own MCP tools.",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "mcp",
    "model-context-protocol",
    "workspace"
  ],
  "license": "MIT",
  "author": "inkyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkyi/dsh-mcp-management.git"
  },
  "homepage": "https://github.com/inkyi/dsh-mcp-management#readme",
  "bugs": {
    "url": "https://github.com/inkyi/dsh-mcp-management/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.3"
  },
  "scripts": {
    "check": "node test/check.mjs",
    "test": "node test/check.mjs && node --test test/unit.test.mjs && node test/client-registration-smoke.mjs",
    "fixture": "node test/fixture-smoke.mjs",
    "sdk-smoke": "node test/sdk-connect-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/*.mjs",
    "vendor/LICENSE*.txt",
    "NOTICE.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
